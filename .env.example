# Firebase Configuration Template
# ⚠️ CRITICAL SECURITY WARNING ⚠️
# 
# NEVER commit the actual .env file to Git!
# This file (.env.example) is a template showing what variables are needed.
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual Firebase credentials in .env
# 3. The .env file is gitignored and will NOT be committed
#
# 🔐 IMPORTANT: After exposing credentials, you MUST rotate your Firebase API keys:
#    - Go to: https://console.firebase.google.com
#    - Select project: sistemamanutencao-8f3a7
#    - Settings > General > Your apps
#    - Regenerate API keys
#    - Update your local .env file with new keys

# Firebase Project Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Development Mode
# Set to 'production' for production builds
NODE_ENV=development
